{
    "name": "tweakphp/client",
    "type": "library",
    "autoload": {
        "psr-4": {
            "TweakPHP\\Client\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Saeed Vaziry",
            "email": "mr.saeedvaziry@gmail.com"
        },
        {
            "name": "David Galet",
            "email": "davidgalet@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psy/psysh": "*",
        "nikic/php-parser": "*",
        "symfony/var-dumper": "^6.4",
        "symfony/console": "^6.4"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "laravel/pint": "^1.29",
        "humbug/box": "^4.6"
    },
    "autoload-dev": {
        "psr-4": {
            "TweakPHP\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests/",
        "pint": "pint --test"
    }
}
