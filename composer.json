{
    "name": "tweakphp/client",
    "type": "library",
    "license": "MIT",
    "description": "PHAR client for executing PHP code inside a project",
    "autoload": {
        "psr-4": {
            "TweakPHP\\Client\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Saeed Vaziry",
            "email": "mr.saeedvaziry@gmail.com"
        },
        {
            "name": "David Galet",
            "email": "davidgalet@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "psy/psysh": "^0.12",
        "nikic/php-parser": "^5.0",
        "symfony/var-dumper": "^5.4 || ^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^5.4 || ^6.4 || ^7.0 || ^8.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "laravel/pint": "^1.29"
    },
    "autoload-dev": {
        "psr-4": {
            "TweakPHP\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests/"
    }
}
